# ---------------------------------------------------------------------------
# TEMPLATE for environment variables. This file IS committed to git.
# Copy it to ".env" (which is git-ignored) and fill in real values there:
#     cp .env.example .env
# Never put real secrets in THIS file.
# ---------------------------------------------------------------------------

# --- LLM provider -----------------------------------------------------------
# Which model backend to use: "ollama" (local, free) or "openai" (paid).
LLM_PROVIDER=ollama

# Ollama settings (used when LLM_PROVIDER=ollama).
OLLAMA_MODEL=qwen3
OLLAMA_BASE_URL=http://localhost:11434

# OpenAI settings (used when LLM_PROVIDER=openai). Leave key blank if unused.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Database ---------------------------------------------------------------
# Must match the credentials in docker-compose.yml.
# Note the port 5433 (host side) and +psycopg for the async driver used later.
POSTGRES_USER=travel
POSTGRES_PASSWORD=travel
POSTGRES_DB=travel
DATABASE_URL=postgresql+psycopg://travel:travel@localhost:5433/travel

# --- Tracing (added in phase 1 / phase 7) -----------------------------------
# LangSmith: set ENABLED=true and paste your key to see traces at smith.langchain.com
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=travel-assistant
# US: https://api.smith.langchain.com  |  EU: https://eu.api.smith.langchain.com
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- Duffel (flights, phase 3) ---
# Get a free test key at https://app.duffel.com (Developers > Access tokens).
# A test key (duffel_test_...) uses sandbox data only: no real money, no real flights.
DUFFEL_API_KEY=
